{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":pinAllExceptPeerDependencies",
    "helpers:pinGitHubActionDigests"
  ],
  "minimumReleaseAge": "7 days",
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "groupName": "nextjs-and-react",
      "matchPackageNames": ["next", "react", "react-dom"]
    },
    {
      "groupName": "python-core-api",
      "matchPackageNames": ["fastapi", "pydantic", "pydantic-settings", "sqlalchemy", "asyncpg", "alembic"]
    },
    {
      "groupName": "agentic-protocols",
      "matchPackageNames": ["langgraph", "langgraph-checkpoint-postgres", "mcp", "ag-ui-protocol", "@ag-ui/client", "@ag-ui/core"]
    }
  ]
}
