# =============================================================================
# SSRA Assist (ssra-cx) — Sovereign Environment Variables Template (.env.example)
# Copy to .env (and symlink infra/compose/.env -> ../../.env) for local / GPU runs
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Runtime Mode & Sovereign Air-Gap Controls
# -----------------------------------------------------------------------------
SSRA_ENV=development
APP_ENV=development
SSRA_SOVEREIGN_MODE=true
HF_HOME=/home/developer/huggingface_cache
SSRA_HF_CACHE_DIR=/home/developer/huggingface_cache
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
VLLM_NO_USAGE_STATS=1
DO_NOT_TRACK=1

# -----------------------------------------------------------------------------
# 2. Free GPU Device Allocation (NVIDIA RTX A6000)
# -----------------------------------------------------------------------------
SSRA_GPU_DEVICE_ID=2
ORPHEUS_GPU_ID=3
SUNFLOWER_GPU_ID=4
REASONER_GPU_ID=7

# -----------------------------------------------------------------------------
# 3. Sovereign LLM, ASR & TTS Model Configuration
# -----------------------------------------------------------------------------
LLM_BACKEND=vllm
SUNFLOWER_MODEL=Sunbird/Sunflower-Qwen3.5-9B
SUNFLOWER_LOCAL_MODEL_DIR=/mnt/nas1/caches/huggingface_cache/hub/models--Sunbird--Sunflower-Qwen3.5-9B/snapshots/c56081c5024b1c11186a69898f5f6a7a2dabe454
SUNFLOWER_QUANTIZATION=fp8
SUNFLOWER_KV_CACHE_DTYPE=fp8
SUNFLOWER_DTYPE=auto
SUNFLOWER_MAX_MODEL_LEN=262144
SUNFLOWER_GPU_MEM_UTIL=0.90
SUNFLOWER_MAX_NUM_SEQS=12
SUNFLOWER_MAX_BATCH_TOKENS=16384

REASONER_MODEL=Qwen/Qwen3.8-27B-FP8
REASONER_LOCAL_MODEL_DIR=/mnt/nas1/caches/huggingface_cache/hub/models--Qwen--Qwen3.8-27B-FP8/snapshots/017b9c7af6b5689d5dd426a76e0bc077eb5ca20a
REASONER_KV_CACHE_DTYPE=fp8
REASONER_DTYPE=auto
REASONER_MAX_MODEL_LEN=65536
REASONER_GPU_MEM_UTIL=0.90
REASONER_MAX_NUM_SEQS=8

WHISPER_SALT_MODEL=Sunbird/SunflowerASR-51-african-languages
DOCKER_IMAGE_ORPHEUS=app-orpheus-tts
ORPHEUS_GPU_MEM_UTIL=0.35
ORPHEUS_QUANTIZATION=fp8

# -----------------------------------------------------------------------------
# 4. PostgreSQL 18, Qdrant Vector DB, Valkey & Keycloak 26.4.11
# -----------------------------------------------------------------------------
SSRA_POSTGRES_IMAGE=bsms-postgres:18-pgaudit
POSTGRES_USER=ssra
POSTGRES_DB=ssra_cx
POSTGRES_PASSWORD=replace_with_local_postgres_password
POSTGRES_PORT=25432

KC_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace_with_local_keycloak_password
KC_HOSTNAME=https://sso.ssra.gov.ss

SSRA_MEMORY_VECTOR_BACKEND=qdrant
SSRA_QDRANT_URL=http://ssra-qdrant:6333
SSRA_QDRANT_HOST_PORT=26333
SSRA_REDIS_URL=redis://ssra-valkey:6379/0
SSRA_VALKEY_HOST_PORT=26379

# -----------------------------------------------------------------------------
# 5. BFF Ports, Internal Service URLs & Live Ngrok Tunnel
# -----------------------------------------------------------------------------
SSRA_NGROK_PORT=3032
SSRA_WEB_PORT=3033
SSRA_CONSOLE_PORT=3034
SSRA_API_PORT=18000
SSRA_API_PUBLIC_PORT=8083
SSRA_RUNTIME_PORT=18001
SSRA_ORPHEUS_PORT=18100
SSRA_SUNFLOWER_PORT=8011
SSRA_REASONER_PORT=8012
INTERNAL_API_URL=http://ssra-api:8000
INTERNAL_RUNTIME_URL=http://ssra-agent-runtime:8001
SSRA_NGROK_URL=https://struttingly-nongeological-briella.ngrok-free.dev
