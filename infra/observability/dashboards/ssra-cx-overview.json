{
  "title": "SSRA Assist — Omnichannel CX, AI Quality, Safety & SLO Overview",
  "uid": "ssra-cx-overview-v1",
  "timezone": "Africa/Juba",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Quality-Adjusted Containment Rate & Language Decisions (en, pga, ar, din, nus, bfa, zne, shk)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "ssra:chat_turns:containment_ratio_1h"
        },
        {
          "expr": "sum by (locale, source) (rate(ssra_language_decisions_total[5m]))"
        }
      ]
    },
    {
      "id": 2,
      "title": "API Availability & Security Events (Target: 99.9%)",
      "type": "stat",
      "targets": [
        {
          "expr": "1 - ssra:http_errors_5xx:ratio_rate5m"
        },
        {
          "expr": "sum by (event) (rate(ssra_security_events_total[5m]))"
        }
      ]
    },
    {
      "id": 3,
      "title": "Latency SLOs: Chat Turn p95 by Channel & Mode (<= 3000ms) and Core Web Vitals",
      "type": "timeseries",
      "targets": [
        {
          "expr": "ssra:chat_response_time_ms:p95_by_channel_5m"
        },
        {
          "expr": "ssra:chat_response_time_ms:p95_by_mode_5m"
        },
        {
          "expr": "histogram_quantile(0.75, sum by (le, metric) (rate(ssra_web_vitals_ms_bucket[5m])))"
        }
      ]
    },
    {
      "id": 4,
      "title": "Faithfulness Mean (30m) & Retrieval Fallback Ratio",
      "type": "gauge",
      "targets": [
        {
          "expr": "ssra:faithfulness_score:mean_30m"
        },
        {
          "expr": "ssra:retrieval_keyword_fallback:ratio_rate10m"
        }
      ]
    },
    {
      "id": 5,
      "title": "Qdrant Index Freshness & Drift Status",
      "type": "state-timeline",
      "targets": [
        {
          "expr": "ssra_qdrant_index_fresh"
        },
        {
          "expr": "ssra_qdrant_index_drift"
        }
      ]
    }
  ]
}
