{
  "realm": "ssra",
  "enabled": true,
  "displayName": "South Sudan Revenue Authority (SSRA) Sovereign Identity Realm",
  "sslRequired": "all",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 120,
  "ssoSessionIdleTimeout": 900,
  "ssoSessionMaxLifespan": 28800,
  "offlineSessionIdleTimeout": 0,
  "eventsEnabled": true,
  "eventsListeners": ["jboss-logging"],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "attributes": {
    "acr.loa.map": "{\"urn:ssra:acr:otp-t1\":1,\"urn:ssra:acr:t3-step-up\":3,\"urn:ssra:acr:passkey\":3}",
    "parRequestUriLifespan": "60"
  },
  "webAuthnPolicyRpEntityName": "South Sudan Revenue Authority (SSRA)",
  "webAuthnPolicySignatureAlgorithms": ["ES256", "EdDSA"],
  "webAuthnPolicyAttestationConveyancePreference": "direct",
  "webAuthnPolicyAuthenticatorAttachment": "cross-platform",
  "webAuthnPolicyRequireResidentKey": "Yes",
  "webAuthnPolicyUserVerificationRequirement": "required",
  "webAuthnPolicyAvoidSameAuthenticatorRegister": true,
  "roles": {
    "realm": [
      { "name": "agent", "description": "SSRA Contact-Centre & Tax Desk Officer" },
      { "name": "supervisor", "description": "SSRA Contact-Centre Supervisor" },
      { "name": "qa", "description": "SSRA Quality Assurance Reviewer" },
      { "name": "legal_approver", "description": "SSRA Legal & Policy Snapshot Approver" },
      { "name": "secops", "description": "SSRA Security Operations & Audit Officer" },
      { "name": "admin", "description": "SSRA Platform Administrator (JIT Elevated)" },
      { "name": "auditor", "description": "SSRA Read-Only Forensic & ISO/IEC 42001 Auditor" },
      { "name": "ssra_staff", "description": "SSRA Console Tax Agent Role" },
      { "name": "ssra_admin", "description": "SSRA Console Administrator Role" },
      { "name": "ssra_auditor", "description": "SSRA Console Read-Only Auditor Role" }
    ]
  },
  "clientScopes": [
    { "name": "mcp:tools:read", "protocol": "openid-connect" },
    { "name": "mcp:knowledge:read", "protocol": "openid-connect" },
    { "name": "mcp:tax-facts:read", "protocol": "openid-connect" },
    { "name": "mcp:official-channels:read", "protocol": "openid-connect" },
    { "name": "mcp:official-channels:write", "protocol": "openid-connect" },
    { "name": "mcp:taxpayer:read", "protocol": "openid-connect" },
    { "name": "mcp:taxpayer:write", "protocol": "openid-connect" },
    { "name": "mcp:ledger:read", "protocol": "openid-connect" },
    { "name": "mcp:ledger:write", "protocol": "openid-connect" },
    { "name": "mcp:ledger:step_up", "protocol": "openid-connect" },
    { "name": "mcp:payments-info:read", "protocol": "openid-connect" },
    { "name": "mcp:payments-info:step_up", "protocol": "openid-connect" },
    { "name": "mcp:tcc:read", "protocol": "openid-connect" },
    { "name": "mcp:tcc:step_up", "protocol": "openid-connect" },
    { "name": "mcp:customs:read", "protocol": "openid-connect" },
    { "name": "mcp:customs:write", "protocol": "openid-connect" },
    { "name": "mcp:cases:read", "protocol": "openid-connect" },
    { "name": "mcp:cases:write", "protocol": "openid-connect" },
    { "name": "mcp:appointments:read", "protocol": "openid-connect" },
    { "name": "mcp:appointments:write", "protocol": "openid-connect" },
    { "name": "mcp:notifications:read", "protocol": "openid-connect" },
    { "name": "mcp:notifications:write", "protocol": "openid-connect" }
  ],
  "identityProviders": [
    {
      "alias": "ssra-national-idp",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "config": {
        "validateSignature": "true",
        "useJwksUrl": "true",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "syncMode": "FORCE"
      }
    }
  ],
  "clients": [
    {
      "clientId": "ssra-web-bff",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "frontchannelLogout": false,
      "baseUrl": "/en",
      "redirectUris": [
        "https://assist.ssra.gov.ss/signin/callback",
        "http://127.0.0.1:3032/signin/callback",
        "http://127.0.0.1:3033/signin/callback",
        "http://localhost:3000/signin/callback"
      ],
      "webOrigins": [
        "https://assist.ssra.gov.ss",
        "http://127.0.0.1:3032",
        "http://127.0.0.1:3033",
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "token.exchange.standard.enabled": "true",
        "oauth2.dpop.bound.access.tokens": "true",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "true",
        "backchannel.logout.url": "https://assist.ssra.gov.ss/api/auth/backchannel-logout",
        "post.logout.redirect.uris": "https://assist.ssra.gov.ss/en##http://127.0.0.1:3032/en##http://localhost:3000/en",
        "use.refresh.tokens": "true",
        "client.offline.session.idle.timeout": "0"
      },
      "protocolMappers": [
        {
          "name": "ssra-web-audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ssra-web-bff",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "ssra-staff-console",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "frontchannelLogout": false,
      "baseUrl": "/admin",
      "redirectUris": [
        "https://console.ssra.gov.ss/signin/callback",
        "http://127.0.0.1:3034/signin/callback",
        "http://localhost:3034/signin/callback"
      ],
      "webOrigins": [
        "https://console.ssra.gov.ss",
        "http://127.0.0.1:3034",
        "http://localhost:3034"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "default.acr.values": "urn:ssra:acr:passkey",
        "minimum.acr.value": "urn:ssra:acr:passkey",
        "token.exchange.standard.enabled": "true",
        "oauth2.dpop.bound.access.tokens": "true",
        "require.pushed.authorization.requests": "true",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "true",
        "backchannel.logout.url": "https://console.ssra.gov.ss/api/auth/backchannel-logout",
        "post.logout.redirect.uris": "https://console.ssra.gov.ss/signin##http://127.0.0.1:3034/signin##http://localhost:3034/signin"
      },
      "protocolMappers": [
        {
          "name": "ssra-console-audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ssra-staff-console",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "ssra-realm-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "ssra-office-code-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "office_code",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "office_code",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
