"""Stateless MCP 2026-07-28 server for SSRA {{SERVER_NAME}} (Generated from mcp-servers/_template/)."""

from __future__ import annotations

from typing import Any

from ssra_core import RiskTier, juba_today
from ssra_mcp import (
    JSON_SCHEMA_2020_12,
    RegisteredTool,
    StatelessMcpServer,
    ToolAnnotations,
    ToolContext,
)


def create_{{PACKAGE_SUFFIX}}_mcp_server() -> StatelessMcpServer:
    """Create the stateless MCP 2026-07-28 server for SSRA {{SERVER_NAME}}."""
    server = StatelessMcpServer(server_name="{{SERVER_NAME}}")

    def _ping_handler(_args: dict[str, Any], _ctx: ToolContext) -> dict[str, Any]:
        """Execute the generated {{TOOL_NAME}} handler with provenance metadata."""
        return {
            "status": "ok",
            "record_id": "{{SERVER_NAME}}:ping",
            "as_of": juba_today().isoformat(),
        }

    server.register_tool(
        RegisteredTool(
            name="{{TOOL_NAME}}",
            description="{{TOOL_DESCRIPTION}}",
            tier=RiskTier.{{TIER}},
            annotations=ToolAnnotations(readOnlyHint=True, idempotentHint=True),
            input_schema={
                "$schema": JSON_SCHEMA_2020_12,
                "type": "object",
                "additionalProperties": False,
                "properties": {},
            },
            output_schema={
                "$schema": JSON_SCHEMA_2020_12,
                "type": "object",
                "additionalProperties": False,
                "required": ["status", "record_id", "as_of"],
                "properties": {
                    "status": {"type": "string"},
                    "record_id": {"type": "string"},
                    "as_of": {"type": "string"},
                },
            },
            data_classification="PUBLIC",
            upstream_system="ssra-{{SERVER_NAME}}-adapter",
            handler=_ping_handler,
        )
    )
    return server


mcp_server = create_{{PACKAGE_SUFFIX}}_mcp_server()
app = mcp_server.create_fastapi_app()
