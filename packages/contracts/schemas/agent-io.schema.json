{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ssra.gov.ss/schemas/agent-io.schema.json",
  "title": "AgentIOContracts",
  "description": "Typed structured I/O contracts for the SSRA Assist LangGraph runtime (Intent, Plan, ToolCall, HandoffTicket, Answer).",
  "type": "object",
  "$defs": {
    "RiskTier": {
      "type": "string",
      "enum": ["T0", "T1", "T2", "T3", "T4"]
    },
    "LocaleCode": {
      "type": "string",
      "enum": ["en", "pga", "ar", "din", "nus", "bfa", "zne", "shk"]
    },
    "Intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "slots", "language", "confidence"],
      "properties": {
        "intent": {
          "type": "string",
          "enum": [
            "knowledge_qa",
            "guided_tin_registration",
            "guided_filing_and_payment",
            "guided_tcc",
            "calculate_paye",
            "calculate_withholding",
            "verify_official_channel",
            "report_scam",
            "get_balance",
            "get_filing_status",
            "get_tcc_status",
            "book_appointment",
            "create_case",
            "request_waiver_or_dispute_t4",
            "human_handoff",
            "out_of_scope"
          ]
        },
        "slots": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        },
        "language": { "$ref": "#/$defs/LocaleCode" },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    },
    "Citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "snapshot_version", "doc_title", "section_anchor", "effective_from"],
      "properties": {
        "id": { "type": "string" },
        "snapshot_version": { "type": "string" },
        "doc_title": { "type": "string" },
        "section_anchor": { "type": "string" },
        "effective_from": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "NumericClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "source_ref"],
      "properties": {
        "value": { "type": "string", "description": "Exact decimal string" },
        "unit": {
          "type": "string",
          "enum": ["SSP", "USD", "PERCENT", "DAY_OF_MONTH", "DAYS", "YEAR", "COUNT"]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Artifact ID or TaxFact key proving numeric provenance"
        }
      }
    },
    "GenerativeUIComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "props"],
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "BalanceCard",
            "FilingStatusTimeline",
            "PaymentInstructionsCard",
            "CalculatorForm",
            "CitationList",
            "ConfirmActionSheet",
            "HandoffCard"
          ]
        },
        "props": {
          "type": "object"
        }
      }
    },
    "Answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segments", "citations", "numbers", "is_estimate", "abstained"],
      "properties": {
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "citation_ids"],
            "properties": {
              "text": { "type": "string" },
              "citation_ids": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "citations": {
          "type": "array",
          "items": { "$ref": "#/$defs/Citation" }
        },
        "numbers": {
          "type": "array",
          "items": { "$ref": "#/$defs/NumericClaim" }
        },
        "ui_component": {
          "anyOf": [{ "$ref": "#/$defs/GenerativeUIComponent" }, { "type": "null" }]
        },
        "is_estimate": { "type": "boolean" },
        "abstained": { "type": "boolean" }
      }
    }
  }
}
